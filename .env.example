# Keep the dashboard on loopback; use a private tunnel for remote access.
VINE_SEARCH_IMAGE=ghcr.io/sageframe-no-kaji/vine-search:0.1.1
VINE_SEARCH_BIND=127.0.0.1
VINE_SEARCH_PORT=8765
VINE_SEARCH_DATA_DIR=./data
# Optional client IP/CIDR allowlist. Empty preserves loopback/tunnel installations.
# For direct private-network access, list only operator device IPs plus loopback:
# VINE_SEARCH_ALLOWED_CLIENTS=127.0.0.1/32,::1/128,100.100.100.10/32
VINE_SEARCH_ALLOWED_CLIENTS=
# Generate the internal service secret during setup. Never publish this value.
VINE_SEARCH_COLLECTOR_SECRET=
# Optional advanced import. Normal onboarding uses the served login browser.
# VINE_SEARCH_AUTH_FILE=/private/path/to/storage-state.json
